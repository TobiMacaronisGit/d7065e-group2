# D7065E Group 2 - counterpart to the redrawn report, 11 October 2026.
# Checked implementation: 66e0805. Original docs/diagrams sources are preserved.
# Render: d2 --theme 0 --pad 30 context.d2 context.svg
# Colours: blue project; purple infrastructure; green device; grey course/external.
classes: {
  service: {style: {fill: "#DBEAFE"; stroke: "#333333"; stroke-width: 2; font-size: 18}}
  infrastructure: {style: {fill: "#EDE9FE"; stroke: "#333333"; stroke-width: 2; font-size: 18}}
  device: {style: {fill: "#DCFCE7"; stroke: "#333333"; stroke-width: 2; font-size: 18}}
  external: {style: {fill: "#F0F0F0"; stroke: "#333333"; stroke-width: 2; font-size: 18}}
  note: {style: {fill: "#FFFFD9"; stroke: "#777777"; stroke-width: 1; font-size: 16; bold: false; italic: false}}
  phase: {style: {fill: "#FFFFFF"; stroke: "#BBBBBB"; stroke-width: 1; font-size: 16; font-color: "#666666"; bold: true}}
  msg: {style: {stroke: "#333333"; stroke-width: 2; font-size: 16; bold: false; italic: false}}
  ret: {style: {stroke: "#333333"; stroke-width: 2; stroke-dash: 5; font-size: 16; bold: false; italic: false}}
  check: {shape: diamond; style: {fill: "#EBEBFF"; stroke: "#333333"; stroke-width: 2; font-size: 18}}
}

direction: down

occupant: "Occupants" {
  class: external
}
manager: "Building manager" {
  class: external
}
occupancysim: "occupancysim\nPeople, bookings, clock" {
  class: external
}
sys: "Ventilation and climate control\nFive rooms on level 0\nPhysics, devices, control,\nplanning and history" {
  class: service
}
buildsim: "BuildSim\nOccupancy, values, reached states\nBrowser 3D view" {
  class: external
}
occupant -> occupancysim: "presence" {class: msg}
occupancysim -> buildsim: "occupancy + entities" {class: msg}
occupancysim -> sys: "clock + bookings" {class: ret}
buildsim -> sys: "room inputs" {class: ret}
sys -> buildsim: "values / states / view" {class: msg}
sys -> manager: "history / decisions" {class: msg}
buildsim -> manager: "3D view" {class: ret}
scope: "Scope and boundary\nA109/A117: lectures; A110: fika; A323/A113C: offices.\nNo manual override. Shared lab host/network.\nTruth separation is a code convention.\nBalance CO₂, thermal comfort and radiator + AHU energy.\nManager also sees health; BuildSim shows conditions and alerts.\nClock factor: 60 sim-seconds per wall-second.\n\nShort-label contracts\nRoom inputs: occupancy and reached actuator states.\nWrites: sensor values, reached states, room layers and alerts.\nDashed arrows: read/browser responses; solid: messages/writes." {
  class: note
  near: bottom-center
}
