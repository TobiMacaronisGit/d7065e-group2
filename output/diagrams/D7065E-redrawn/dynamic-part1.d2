# D7065E Group 2 - counterpart to the redrawn report, 11 October 2026.
# Checked implementation: 66e0805. Original docs/diagrams sources are preserved.
# Render: d2 --theme 0 --pad 30 dynamic-part1.d2 dynamic-part1.svg
# Colours: blue project; purple infrastructure; green device; grey course/external.
# Illustrative source order and original step numbers are preserved.
# Actual planner code fetches history before consulting cached bookings (15 s wall TTL).
# SimClock polls separately; the 10-s phase label denotes the planning loop.
# A117 is booked 10:15-12:00. History uses until + max_age_s and simulated-time ordering.
# Plan includes u*, peak at u*, and preheat target. Control already has live readings.
# Commands require changed targets; decisions are published every evaluation.
# Actuation uses QoS 1 and retention. Heating follows the same actuation/read-back path.
# occupancy_counter independently publishes observed head counts.
# Step 20 archives concurrently, not as a final batch. It is caption text in report part 2.
# Reactive control continues if history or timetable requests fail.
classes: {
  service: {style: {fill: "#DBEAFE"; stroke: "#333333"; stroke-width: 2; font-size: 18}}
  infrastructure: {style: {fill: "#EDE9FE"; stroke: "#333333"; stroke-width: 2; font-size: 18}}
  device: {style: {fill: "#DCFCE7"; stroke: "#333333"; stroke-width: 2; font-size: 18}}
  external: {style: {fill: "#F0F0F0"; stroke: "#333333"; stroke-width: 2; font-size: 18}}
  note: {style: {fill: "#FFFFD9"; stroke: "#777777"; stroke-width: 1; font-size: 16; bold: false; italic: false}}
  phase: {style: {fill: "#FFFFFF"; stroke: "#BBBBBB"; stroke-width: 1; font-size: 16; font-color: "#666666"; bold: true}}
  msg: {style: {stroke: "#333333"; stroke-width: 2; font-size: 16; bold: false; italic: false}}
  ret: {style: {stroke: "#333333"; stroke-width: 2; stroke-dash: 5; font-size: 16; bold: false; italic: false}}
  check: {shape: diamond; style: {fill: "#EBEBFF"; stroke: "#333333"; stroke-width: 2; font-size: 18}}
}

shape: sequence_diagram

occupancysim: "occupancysim" {
  class: external
}
pipeline: "pipeline" {
  class: infrastructure
}
planner: "planner" {
  class: service
}
broker: "MQTT broker" {
  class: infrastructure
}
control: "control" {
  class: service
}

inputs: "Inputs (every 10 s wall)" {
  class: phase
  planner -> occupancysim: "1. GET /api/state" {class: msg}
  occupancysim -> planner: "2. Clock + bookings" {class: ret}
  planner -> pipeline: "3. GET /history" {class: msg}
  pipeline -> planner: "4. Observations" {class: ret}
}
forecast: "Forecast and rollout" {
  class: phase
  planner.step5: "5. Forecast n̂: h=5...30 min\nEarly student/lecturer arrivals\nRoll out CO₂ for u=0...3\nu*: lowest level with peak <900 ppm\nIf none qualifies: use level 3" {
    class: note
  }
}
advice: "Advice and decision" {
  class: phase
  planner -> broker: "6. Retained Plan" {class: msg}
  broker -> control: "7. Deliver plan" {class: msg}
  control.step8: "8. Every 5 s wall\nQuality + mode\nReactive demand\nRaise to plan\nDwell + final clamp" {
    class: note
  }
  control -> broker: "9. Command + decision" {class: msg}
}
